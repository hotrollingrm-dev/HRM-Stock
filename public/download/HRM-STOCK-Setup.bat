'@) -replace '\s', ''
try {
  $mode = $env:HRM_MODE
  $url = ($env:HRM_URL + '').Trim(); if (-not $url) { $url = 'https://hrm-stock.vercel.app/' }
  if ($url -notmatch '^https?://') { $url = 'https://' + $url }
  if (-not $url.EndsWith('/') -and $url -notmatch '\?') { $url += '/' }
  $dir     = Join-Path $env:LOCALAPPDATA 'HRMStock'
  $desk    = [Environment]::GetFolderPath('Desktop')
  $menu    = Join-Path ([Environment]::GetFolderPath('Programs')) 'HRM STOCK'
  $startup = [Environment]::GetFolderPath('Startup')
  $names   = @('HRM STOCK.lnk', 'HRM STOCK Widget.lnk')

  if ($mode -eq 'uninstall') {
    foreach ($n in $names) { foreach ($d in @($desk, $menu, $startup)) { $p = Join-Path $d $n; if (Test-Path $p) { Remove-Item $p -Force } } }
    if (Test-Path $menu) { Remove-Item $menu -Recurse -Force }
    if (Test-Path $dir)  { Remove-Item $dir -Recurse -Force }
    Write-Host '   ✓ ถอนการติดตั้งเรียบร้อย (ข้อมูล STOCK บน Google ไม่ได้ถูกลบ)' -ForegroundColor Green
    return
  }

  # Edge is built into Windows 10/11 — Chrome is the fallback
  $browsers = @(
    "${env:ProgramFiles(x86)}\Microsoft\Edge\Application\msedge.exe",
    "$env:ProgramFiles\Microsoft\Edge\Application\msedge.exe",
    "$env:LOCALAPPDATA\Microsoft\Edge\Application\msedge.exe",
    "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
    "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
    "$env:LOCALAPPDATA\Google\Chrome\Application\chrome.exe")
  $b = $browsers | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1
  if (-not $b) { throw 'ไม่พบ Microsoft Edge หรือ Google Chrome ในเครื่องนี้' }

  New-Item -ItemType Directory -Force $dir  | Out-Null
  New-Item -ItemType Directory -Force $menu | Out-Null
  $iconPath = Join-Path $dir 'hrm-stock.ico'
  [IO.File]::WriteAllBytes($iconPath, [Convert]::FromBase64String($IconB64))

  # widget: small window at the right edge of the main screen
  Add-Type -AssemblyName System.Windows.Forms
  $wa = [System.Windows.Forms.Screen]::PrimaryScreen.WorkingArea
  $wx = [Math]::Max(0, $wa.Right - 404); $wy = $wa.Top + 60
  $base = $url.Split('?')[0]
  # full screen size (1920×1080 or whatever this screen is), opened maximized
  $sw = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds.Width; $sh = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds.Height
  $appArgs = "--app=$url --window-position=0,0 --window-size=$sw,$sh --start-maximized"
  $wgArgs  = "--app=${base}?view=widget --window-size=380,640 --window-position=$wx,$wy"

  $ws = New-Object -ComObject WScript.Shell
  function New-Lnk($path, $arguments, $desc) {
    $l = $ws.CreateShortcut($path); $l.TargetPath = $b; $l.Arguments = $arguments
    $l.IconLocation = "$iconPath,0"; $l.Description = $desc; $l.WorkingDirectory = $dir; $l.Save()
  }
  foreach ($d in @($desk, $menu)) {
    New-Lnk (Join-Path $d 'HRM STOCK.lnk')        $appArgs 'HRM STOCK CONTROL MANAGEMENT'
    New-Lnk (Join-Path $d 'HRM STOCK Widget.lnk') $wgArgs  'HRM STOCK - Widget'
  }
  $auto = Join-Path $startup 'HRM STOCK Widget.lnk'
  if ($env:HRM_AUTOSTART -eq 'Y') { New-Lnk $auto $wgArgs 'HRM STOCK - Widget' } elseif (Test-Path $auto) { Remove-Item $auto -Force }

  Write-Host '   ✓ ติดตั้งเรียบร้อย' -ForegroundColor Green
  Write-Host "     ไอคอนบนหน้าจอ: HRM STOCK  และ  HRM STOCK Widget"
  Write-Host "     ลิงก์: $url"
  Write-Host "     เบราว์เซอร์: $b"
  if ($env:HRM_AUTOSTART -eq 'Y') { Write-Host '     Widget จะเปิดเองทุกครั้งที่เปิดเครื่อง' }
  Write-Host ''
  Write-Host '   กำลังเปิดโปรแกรม…'
  Start-Process $b $appArgs
} catch {
  Write-Host ('   ✗ ติดตั้งไม่สำเร็จ: ' + $_.Exception.Message) -ForegroundColor Red
}
