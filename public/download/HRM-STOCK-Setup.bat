@echo off
chcp 65001 >nul
setlocal
title HRM STOCK - Setup
cls
echo.
echo   ==============================================
echo     HRM STOCK CONTROL MANAGEMENT
echo     ติดตั้งโปรแกรมลงเครื่อง (Web app)
echo   ==============================================
echo.
echo     [1] ติดตั้ง / อัปเดต     (Install)
echo     [2] ถอนการติดตั้ง        (Uninstall)
echo.
choice /c 12 /n /m "   เลือก 1 หรือ 2 : "
if errorlevel 2 goto uninstall

:install
set "HRM_MODE=install"
set "HRM_URL="
echo.
echo   ลิงก์ระบบ  (กด Enter = https://hrm-stock.vercel.app/)
set /p "HRM_URL=   ลิงก์ : "
echo.
choice /c YN /n /m "   เปิด Widget ลอยข้างจอทุกครั้งที่เปิดเครื่อง? [Y/N] : "
if errorlevel 2 (set "HRM_AUTOSTART=N") else (set "HRM_AUTOSTART=Y")
goto run

:uninstall
set "HRM_MODE=uninstall"

:run
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText('%~f0',[Text.Encoding]::UTF8); $m='#PS'+'-START'; iex $s.Substring($s.IndexOf($m)+$m.Length)"
echo.
pause
exit /b

